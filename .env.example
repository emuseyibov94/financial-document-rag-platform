APP_NAME=financial-document-rag-platform
APP_VERSION=0.2.0
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=ai_backend_user
POSTGRES_PASSWORD=ai_backend_password
POSTGRES_DB=ai_backend_foundation
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ai_backend_user:ai_backend_password@postgres:5432/ai_backend_foundation

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_EXTERNAL_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET_DOCUMENTS=documents
OBJECT_STORAGE_REGION=us-east-1